# web/.env.example
# Copia este archivo como .env y ajusta los valores según tu entorno.
# Las variables VITE_* se inlinean en el bundle del cliente en tiempo de build:
# si cambias alguna, debes reconstruir la imagen (docker compose build web).

# URL de la API accesible desde el navegador (dev: puerto publicado del API Go)
VITE_API_URL=http://localhost:8080/api/v1

# URL pública del bucket S3/MinIO en formato Path-Style: {endpoint}/{bucket}
# El navegador debe poder resolver el endpoint (no usar hostnames internos de Docker).
VITE_BUCKET_URL=http://localhost:9000/colpsi-bucket

# URL base del sitio web (canonical, QR, robots.txt y sitemap)
VITE_SITE_URL=http://localhost:3000
