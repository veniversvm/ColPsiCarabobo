# ── ETAPA DE CONSTRUCCIÓN (Builder) ────────────────────────────────────────
# Usamos Debian para construir porque es más robusto con Node y dependencias nativas
FROM denoland/deno:debian-2.7.5 AS builder

# Instalamos Node.js (necesario para que Vinxi/Vite empaqueten los assets)
RUN apt-get update && apt-get install -y nodejs npm

WORKDIR /app

# 1. Copiar archivos de dependencias y descargar
COPY deno.json deno.lock* ./
RUN deno install --frozen=false

# 2. Copiar el código fuente y construir la app para producción (SSR)
COPY . .

# Esto genera la carpeta .output con el servidor compilado
RUN deno task build

# ── ETAPA DE EJECUCIÓN (Final) ─────────────────────────────────────────────
# Volvemos a Alpine para la imagen final para que sea ligera (aprox 80MB)
FROM denoland/deno:alpine-2.7.5

WORKDIR /app

# 3. Copiamos solo los resultados del build y los estáticos
# SolidStart/Vinxi coloca todo lo necesario para el servidor en .output
COPY --from=builder /app/.output ./.output
COPY --from=builder /app/public ./public

# 4. Aseguramos permisos de ejecución
RUN chmod +x .output/server/index.mjs

EXPOSE 3000

# Variables de entorno por defecto (Docker Compose las sobreescribirá)
ENV PORT=3000

# Permisos específicos: red, directorios de lectura, variables de entorno necesarias
CMD ["run", "--allow-net", "--allow-read=.output,public", "--allow-env", ".output/server/index.mjs"]