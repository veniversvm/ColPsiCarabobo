{
    "swagger": "2.0",
    "info": {
        "description": "Backend para la gestión del Colegio de Psicólogos de Carabobo.",
        "title": "ColPsiCarabobo API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/api/v1",
    "paths": {
        "/admin/create": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Registra un nuevo miembro del staff administrativo verificando la jerarquía de permisos.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Administración - Gestión"
                ],
                "summary": "Crear un nuevo administrador",
                "parameters": [
                    {
                        "description": "Datos del nuevo administrador y permisos",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/github_com_veniversvm_ColPsiCarabobo_api_internal_request_structs.CreateAdminRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "message: creado correctamente",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "error: datos inválidos",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "403": {
                        "description": "error: violación de jerarquía",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/admin/delete/{id}": {
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Realiza un borrado lógico del administrador. No permite auto-eliminación ni borrar SUDO.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Administración - Gestión"
                ],
                "summary": "Eliminar administrador (Soft-delete)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "UUID del administrador",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "message: eliminado correctamente",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "error: ID inválido",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "403": {
                        "description": "error: permisos insuficientes",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/admin/list": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Retorna una lista paginada de administradores con soporte para búsqueda y caché.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Administración - Gestión"
                ],
                "summary": "Listar administradores",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Número de página (def: 1)",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Registros por página (def: 10)",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Búsqueda por username o email",
                        "name": "search",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "description": "Filtrar por estado activo (true/false)",
                        "name": "active",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "data, total, page, limit",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "500": {
                        "description": "error: fallo interno",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/admin/update": {
            "patch": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Modifica los datos y permisos de un administrador. Actualiza automáticamente la auditoría.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Administración - Gestión"
                ],
                "summary": "Actualizar administrador",
                "parameters": [
                    {
                        "description": "Campos parciales a actualizar",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/github_com_veniversvm_ColPsiCarabobo_api_internal_request_structs.UpdateAdminRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "message: actualizado correctamente",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "403": {
                        "description": "error: permiso denegado",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/auth/login": {
            "post": {
                "description": "Valida las credenciales del administrador (email o username) y retorna un JWT dinámico.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Administración - Auth"
                ],
                "summary": "Iniciar sesión administrativo",
                "parameters": [
                    {
                        "description": "Credenciales de acceso",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_handler.LoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "message, token",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "error: formato inválido",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "401": {
                        "description": "error: credenciales inválidas",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/psi/upload-csv": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Procesa un archivo CSV y crea registros. Solo accesible para administradores autorizados.",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Psychologists"
                ],
                "summary": "Importar psicólogos masivamente",
                "parameters": [
                    {
                        "type": "file",
                        "description": "Archivo CSV a procesar",
                        "name": "csv",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "404": {
                        "description": "Retornado si el usuario no tiene permisos (Security by Obscurity)",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/specialties": {
            "get": {
                "description": "Retorna especialidades. Los usuarios ven solo las activas. Admins con permiso pueden filtrar por ?status=active|inactive|all.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Catálogos - Especialidades"
                ],
                "summary": "Listar especialidades (Público/Admin)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Filtro administrativo: active, inactive, all (Default: active)",
                        "name": "status",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/github_com_veniversvm_ColPsiCarabobo_api_internal_domain.PsiSpecialty"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Registra una nueva especialidad en el catálogo. Requiere permisos de gestión de etiquetas.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Administración - Especialidades"
                ],
                "summary": "Crear especialidad",
                "parameters": [
                    {
                        "description": "Datos de la especialidad",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/github_com_veniversvm_ColPsiCarabobo_api_internal_request_structs.CreateSpecialtyRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "message",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "403": {
                        "description": "error: permiso denegado",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/specialties/count": {
            "get": {
                "description": "Obtiene el conteo. Público: solo activas. Admin: permite filtrar por estado.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Catálogos - Especialidades"
                ],
                "summary": "Contar total de especialidades",
                "parameters": [
                    {
                        "type": "boolean",
                        "description": "Filtrar por activas (true) o inactivas (false). Omitir para ver todas (Solo Admins).",
                        "name": "active",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "count",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "integer",
                                "format": "int64"
                            }
                        }
                    }
                }
            }
        },
        "/specialties/{id}": {
            "get": {
                "description": "Retorna el detalle de una especialidad específica.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Catálogos - Especialidades"
                ],
                "summary": "Obtener especialidad por ID",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID de la especialidad",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/github_com_veniversvm_ColPsiCarabobo_api_internal_domain.PsiSpecialty"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            },
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Realiza una desactivación lógica de la especialidad para mantener integridad referencial.",
                "tags": [
                    "Administración - Especialidades"
                ],
                "summary": "Eliminar especialidad (Desactivar)",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID de la especialidad",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "message",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            },
            "patch": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Modifica una especialidad existente. Soporta cambios parciales y actualización de estado.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Administración - Especialidades"
                ],
                "summary": "Actualizar especialidad",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID de la especialidad",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Campos a modificar",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/github_com_veniversvm_ColPsiCarabobo_api_internal_request_structs.UpdateSpecialtyRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "message",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "github_com_veniversvm_ColPsiCarabobo_api_internal_domain.PsiSpecialty": {
            "type": "object",
            "properties": {
                "active": {
                    "description": "Correcto: Oculto del JSON",
                    "type": "boolean"
                },
                "create_by": {
                    "description": "CreateBy almacena el nombre o identificador textual del creador.",
                    "type": "string"
                },
                "create_by_id": {
                    "description": "CreateById es el UUID del usuario/administrador que creó el registro.\nEs un puntero para permitir valores nulos si la creación es automática por el sistema.",
                    "type": "string"
                },
                "created_at": {
                    "description": "CreatedAt registra la fecha y hora exacta en que se creó el registro.\nGORM gestiona este campo automáticamente durante la inserción.",
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "id": {
                    "description": "ID es el identificador único universal (UUID) de la entidad.\nSe utiliza gen_random_uuid() a nivel de base de datos para garantizar\nque cada registro tenga una identidad no predecible y segura.",
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "update_by": {
                    "description": "UpdateBy almacena el nombre o identificador textual de la última persona en modificarlo.",
                    "type": "string"
                },
                "update_by_id": {
                    "description": "UpdateById es el UUID del usuario/administrador que realizó la última actualización.",
                    "type": "string"
                },
                "updated_at": {
                    "description": "UpdatedAt registra la última fecha y hora en que se modificó el registro.\nGORM actualiza este valor automáticamente en cada operación de guardado.",
                    "type": "string"
                }
            }
        },
        "github_com_veniversvm_ColPsiCarabobo_api_internal_request_structs.AdminPermissionsDTO": {
            "type": "object",
            "properties": {
                "can_create_admin": {
                    "type": "boolean"
                },
                "can_create_psi": {
                    "type": "boolean"
                },
                "can_create_tags": {
                    "type": "boolean"
                },
                "can_delete_admin": {
                    "type": "boolean"
                },
                "can_delete_psi": {
                    "type": "boolean"
                },
                "can_delete_publish": {
                    "type": "boolean"
                },
                "can_delete_tags": {
                    "type": "boolean"
                },
                "can_edit_tags": {
                    "type": "boolean"
                },
                "can_manage_notifications": {
                    "type": "boolean"
                },
                "can_publish": {
                    "type": "boolean"
                },
                "can_read_notifications": {
                    "type": "boolean"
                },
                "can_send_notifications": {
                    "type": "boolean"
                },
                "can_update_admin": {
                    "type": "boolean"
                },
                "can_update_psi": {
                    "type": "boolean"
                },
                "can_update_publish": {
                    "type": "boolean"
                }
            }
        },
        "github_com_veniversvm_ColPsiCarabobo_api_internal_request_structs.CreateAdminRequest": {
            "type": "object",
            "required": [
                "email",
                "password",
                "username"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "password": {
                    "type": "string",
                    "minLength": 8
                },
                "permissions": {
                    "description": "Permisos que se le quieren asignar",
                    "allOf": [
                        {
                            "$ref": "#/definitions/github_com_veniversvm_ColPsiCarabobo_api_internal_request_structs.AdminPermissionsDTO"
                        }
                    ]
                },
                "username": {
                    "type": "string"
                }
            }
        },
        "github_com_veniversvm_ColPsiCarabobo_api_internal_request_structs.CreateSpecialtyRequest": {
            "type": "object",
            "required": [
                "name"
            ],
            "properties": {
                "description": {
                    "type": "string",
                    "example": "Especialidad enfocada en..."
                },
                "name": {
                    "type": "string",
                    "example": "Psicología Clínica"
                }
            }
        },
        "github_com_veniversvm_ColPsiCarabobo_api_internal_request_structs.UpdateAdminRequest": {
            "type": "object",
            "required": [
                "id"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "is_active": {
                    "type": "boolean"
                },
                "password": {
                    "type": "string"
                },
                "permissions": {
                    "description": "Permisos",
                    "allOf": [
                        {
                            "$ref": "#/definitions/github_com_veniversvm_ColPsiCarabobo_api_internal_request_structs.AdminPermissionsDTO"
                        }
                    ]
                },
                "username": {
                    "type": "string"
                }
            }
        },
        "github_com_veniversvm_ColPsiCarabobo_api_internal_request_structs.UpdateSpecialtyRequest": {
            "type": "object",
            "properties": {
                "active": {
                    "type": "boolean"
                },
                "description": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "internal_handler.LoginRequest": {
            "type": "object",
            "required": [
                "identifier",
                "password"
            ],
            "properties": {
                "identifier": {
                    "type": "string",
                    "example": "admin"
                },
                "password": {
                    "type": "string",
                    "example": "admin123"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}