# api/.env.example
# Copia como .env y ajusta según tu entorno.
# La API Go usa estos valores vía internal/config/env.config.go (config.InitConfig()).

# ── Servidor ───────────────────────────────────────────────────────────────────
PORT=8080
# development | production (controla credenciales del seed, cookies Secure, logs)
APP_ENV=development
# Límite de paralelismo del runtime Go (GOMAXPROCS). docker-compose lo fija a 3
# por defecto (server 4 vCPU: nunca usar todas). Vacío → main.go usa numCPU-1.
GOMAXPROCS=3

# ── Super Admin (seed, solo si no hay administradores) ─────────────────────────
# El seed crea el primer administrador con estos datos. ADMIN_PASSWORD vacío:
#   - development → admin123
#   - production  → aleatoria de 16 chars (se avisa en logs para cambiarla)
# Definir ADMIN_PASSWORD en producción para fijar la contraseña del super admin.
ADMIN_EMAIL=admin@colpsicarabobo.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── Base de datos (PostgreSQL) ─────────────────────────────────────────────────
DB_HOST=localhost        # en Docker Compose lo sobrescribe el servicio api → pgbouncer
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=colpsi_db

# ── S3 / MinIO ─────────────────────────────────────────────────────────────────
# Endpoint INTERNO: lo usa el SDK para subir/bajar objetos (con firma S3).
# Debe apuntar DIRECTAMENTE a MinIO, NUNCA al edge cache nginx (las firmas se
# rompen al pasar por el proxy). En dev local MinIO publica 29002; en Docker el
# compose lo sobrescribe con http://s3:9000.
S3_ENDPOINT=http://localhost:29002
# URL PÚBLICA accesible desde el navegador, formato Path-Style {endpoint}/{bucket}.
# La usa GetPublicURL() (pkg/s3/s3.go) para construir URLs de imágenes.
# En Docker Compose: S3_ENDPOINT=http://s3:9000 y S3_PUBLIC_URL=http://localhost:29000
# El puerto 29000 lo sirve el edge cache nginx (imgcache) — nunca apuntar aquí al
# endpoint interno s3:9000 (gotcha del AGENTS.md).
S3_PUBLIC_URL=http://localhost:29000
AWS_S3_BUCKET=colpsi-bucket
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# ── Email (SMTP) ───────────────────────────────────────────────────────────────
# En dev usa MailHog (profile "dev" del compose): SMTP_HOST=localhost, SMTP_PORT=1025
# El catcher del dev publica en el host: SMTP 21025 / UI http://localhost:28025.
# Dentro de Docker la API conecta a mailhog:1025 (puerto interno sin cambios).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=info@colpsicarabobo.com
SMTP_REPLY_TO=
SMTP_FROM_NAME=Colegio de Psicólogos de Carabobo
# URL pública del frontend y firma mostrada tras "Atentamente" en los correos
# institucionales (welcome/login/reset). Configurables a conveniencia.
APP_URL=http://localhost:3000
MAIL_SIGNATURE=Administración ColPsiCarabobo

# ── Email (Transporte Resend) ──────────────────────────────────────────────────
# MAIL_TRANSPORT=smtp usa SMTP (MailHog/Mailpit). Con "resend" se usa la API de
# Resend y es obligatorio RESEND_API_KEY (deja SMTP_* vacías).
MAIL_TRANSPORT=smtp
RESEND_API_KEY=re_TU_KEY_AQUI
SMTP_FROM=onboarding@resend.dev
# Pacing anti-spam / respeto a cuotas (solo transporte "resend"):
# MAIL_DAILY_CAP=100        # tope diario (warm-up de dominio; Free=100/día)
# MAIL_BATCH_SIZE=100       # máx emails por llamada batch (límite Resend: 100)
# MAIL_BATCH_INTERVAL_MS=1000
# MAIL_BURST_SIZE=30
# MAIL_BURST_SLEEP_MIN=60
# MAIL_BURST_SLEEP_MAX=180
# MAIL_SEND_INTERVAL_MS=500

# ── CORS ───────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://127.0.0.1:3000, http://localhost:3000

# ── Rate limiting store (Valkey/Redis) ─────────────────────────────────────────
# Vacío = fallback en memoria.
VALKEY_ADDR=

# ── MailHog/Mailpit (Solo Dev) ─────────────────────────────────────────────────
# Activa el catcher de correos del compose: `MAILPIT_PROFILE=dev` + `docker compose
# --profile dev up -d`. En producción dejar vacío/ausente → NO se levanta.
MAILPIT_PROFILE=

# ── Seguridad / librerías ──────────────────────────────────────────────────────
JWT_LIBRARY_SECRET=
ABS_ADMIN_TOKEN=

# ── Security headers (helmet) ──────────────────────────────────────────────────
# HSTS_MAX_AGE: segundos del Strict-Transport-Security. Solo se emite sobre HTTPS
#               (requiere X-Forwarded-Proto: https del proxy). Default 31536000 (1 año).
# HSTS_PRELOAD: añade "; preload" al header (solo tras registrarse en hstspreload.org).
HSTS_MAX_AGE=31536000
HSTS_PRELOAD=false

# ── Biblioteca Virtual (Audiobookshelf) ────────────────────────────────────────
# ABS_BASE_URL:  URL interna que usa la API para hablar con ABS (desde Docker:
#                http://audiobookshelf:80). NUNCA la pública.
# ABS_PUBLIC_URL: URL que abre el navegador (auto-login). En Docker dev:
#                http://localhost:21337.
# ABS_ADMIN_USERNAME/PASSWORD: credenciales del admin de ABS usado para
#                aprovisionar (crear) las cuentas de los agremiados.
# ABS_PASSWORD_SECRET: secreto con el que se deriva la clave de cada agremiado.
#                ¡Generar uno aleatorio y mantenerlo privado! Ej:
#                openssl rand -hex 24
# ABS_SYNC_INTERVAL_HOURS: horas entre sincronizaciones masivas de cuentas ABS
#                (crea solventes faltantes y desactiva insolventes). Se dispara
#                una vez al arrancar y luego cada N horas. <=0 desactiva. Default 24.
ABS_BASE_URL=
ABS_PUBLIC_URL=
ABS_ADMIN_USERNAME=
ABS_ADMIN_PASSWORD=
ABS_PASSWORD_SECRET=
ABS_SYNC_INTERVAL_HOURS=24
